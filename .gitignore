# OS
.DS_Store
Thumbs.db

# Test EPUBs (libros de prueba, no van al repo). Anclado a la raíz: sin la
# barra inicial también ignoraba lib/epub/, y lib/epub/text_align.dart nunca
# llegó a comitearse -- un clon nuevo del repo no compilaba.
/epub/

# Caché de audio generada por la app (no del repo)
*.mp3
*.wav

# Claude Code (settings.local.json tiene rutas específicas de la máquina)
.claude/settings.local.json
muestras_voz/

# Capturas de referencia (apps de la competencia, pruebas en el teléfono):
# material de trabajo, no documentación del repo
docs/screenshot/

# Pipeline de reportes: venv local, estado del ledger y sus propios logs
tools/reportes/.venv/
tools/reportes/estado/
tools/reportes/logs/

# Configuración de compilación por probador: lleva el token dentro
tools/release/*.json
!tools/release/tester.example.json
# Excepción: voz.json lleva solo la dirección del servidor, sin token. La
# dirección no es secreta -un APK la lleva en claro-; el token vive en el .json
# personal, que sí queda ignorado (ver tools/release/README.md).
!tools/release/voz.json

# Cache de bytecode de las pruebas de tools/reportes
tools/reportes/__pycache__/

# Servidor de voz en el Mac (tools/mlx): voces clonadas, token y entorno propios
tools/mlx/voices/*
!tools/mlx/voices/.gitkeep
tools/mlx/.token
tools/mlx/.venv/
tools/mlx/__pycache__/

# Reportes recibidos por tools/mlx/server.py: texto y notas de voz de personas
# reales. El procesador los vuelca a docs/ y los archiva aquí.
tools/mlx/reportes/

# Libros de prueba para importar: tienen derechos de autor y no son del proyecto
epubs/

# Audio generado en el Mac, a la espera de pasarlo al teléfono
tools/audios/salida/
